# Load these into your process environment; this starter does not auto-load .env.
DATABASE_URL=postgresql+psycopg://ctf:CHANGE_ME@localhost:5432/ctf
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLAG_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ALLOWED_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
